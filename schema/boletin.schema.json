{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boletín diario",
  "type": "object",
  "required": ["fecha", "titulo", "ejemplo", "semaforo", "destacados", "margen", "precios", "secciones", "anguloComercial", "agenda"],
  "properties": {
    "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "titulo": { "type": "string", "minLength": 1 },
    "ejemplo": { "type": "boolean" },
    "generado": { "type": "string", "description": "Fecha y hora ISO de generación" },
    "semaforo": {
      "type": "object",
      "required": ["nivel", "motivo"],
      "properties": {
        "nivel": { "enum": ["verde", "amarillo", "rojo"] },
        "motivo": { "type": "string" }
      }
    },
    "destacados": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 },
    "margen": {
      "type": "object",
      "required": ["tendencia", "texto"],
      "properties": {
        "tendencia": { "enum": ["mejora", "se mantiene", "empeora"] },
        "texto": { "type": "string" }
      }
    },
    "precios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["producto", "valor", "fecha", "fuente"],
        "properties": {
          "producto": { "type": "string" },
          "valor": { "type": "string" },
          "variacion": { "type": "string" },
          "fecha": { "type": "string" },
          "fuente": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "secciones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titulo", "items"],
        "properties": {
          "id": { "enum": ["sanidad", "ganadero", "agrario", "geopolitica", "rentabilidad"] },
          "titulo": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["titular", "resumen", "detalle", "soloLargo", "fecha"],
              "properties": {
                "titular": { "type": "string" },
                "ambito": { "enum": ["local", "España", "UE", "mundo"] },
                "resumen": { "type": "string" },
                "detalle": { "type": "string" },
                "soloLargo": { "type": "boolean" },
                "afectaMiZona": { "type": "boolean" },
                "fecha": { "type": "string" },
                "fuente": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "anguloComercial": { "type": "array", "items": { "type": "string" } },
    "agenda": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fecha", "evento"],
        "properties": {
          "fecha": { "type": "string" },
          "evento": { "type": "string" },
          "lugar": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    }
  }
}
